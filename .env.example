# .env.example
# -------------
# Template for the real .env file -- the one holding actual credentials.
#
# Setup:
#   1. Copy this file and rename the copy to .env
#      (same folder, e.g. D:\projects\re-image-library\.env)
#   2. Fill in the real values below.
#   3. Never commit .env to Git -- add it to .gitignore.
#      This example file (placeholder values only) is safe to commit.
#
# Scripts load these with python-dotenv:
#   pip install python-dotenv --break-system-packages
#
#   from dotenv import load_dotenv
#   import os
#   load_dotenv()
#   CLOUDINARY_API_KEY = os.getenv("CLOUDINARY_API_KEY")
#   (repeat os.getenv(...) for each variable below)

# ---------------- Cloudinary ----------------
# From: Cloudinary Console -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ---------------- Google Sheets ----------------
# SERVICE_ACCOUNT_FILE: path to the JSON key downloaded when you created
# the dedicated RE service account (Google Cloud Console -> IAM & Admin
# -> Service Accounts -> [your account] -> Keys -> Add Key -> JSON).
# Keep this JSON file in the same folder as .env, gitignored alongside
# it -- it is itself a credential, not just a reference to one.
SERVICE_ACCOUNT_FILE=D:\projects\re-image-library\re-sheets-writer-key.json

# SHEET_ID: the long ID in the sheet's URL, between /d/ and /edit
# e.g. https://docs.google.com/spreadsheets/d/THIS_PART/edit
SHEET_ID=your_sheet_id_here

# ---------------- Local paths ----------------
# Root folder this script watches for files ready to upload.
UPLOAD_DIR=D:\project-images\1-re-images\library\upload
ARCHIVE_DIR=D:\project-images\1-re-images\library\upload\processed